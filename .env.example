COMPOSE_PROJECT_NAME=tasklane
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
PUBLIC_URL=http://localhost:3010
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
POSTGRES_DB=tasklane
POSTGRES_USER=basecore
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_PORT=5440
DATABASE_URL=postgresql://basecore:replace-with-a-random-database-password@127.0.0.1:5440/tasklane
BACKEND_PORT=8010
FRONTEND_PORT=3010
BACKEND_URL=http://127.0.0.1:8010
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-encryption-key
